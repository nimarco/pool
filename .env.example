# Pool — example environment configuration.
#
# Copy to `.env` and fill in locally. NEVER commit a real `.env`. See AGENTS.md §4.
# Keys only, no secret values. Add new keys here whenever you add one to `.env`, so a
# fresh clone knows what the system expects.
#
# Every default below is the free, offline, deterministic one. Running Pool with no
# environment at all costs nothing and touches no external service.

# -----------------------------------------------------------------------------
# AWS
# Prefer a named profile or an IAM role over static keys. Do not put access keys here.
# -----------------------------------------------------------------------------
AWS_REGION=
AWS_PROFILE=

# -----------------------------------------------------------------------------
# Model configuration
# "offline" runs the real Strands loop with a deterministic planner in place of the
# LLM — zero token cost, and what every test and local demo uses. "bedrock" is the
# real model. Model choice is a cost decision (AGENTS.md §3.3); changing it deserves a
# BUILD_HISTORY entry.
#
# Bedrock model ids are inference-profile-scoped and vary by account and region. List
# what the account actually has before setting one:
#   aws bedrock list-inference-profiles --region "$AWS_REGION" \
#     --query 'inferenceProfileSummaries[?contains(inferenceProfileId, `anthropic`)].inferenceProfileId'
# -----------------------------------------------------------------------------
MODEL_PROVIDER=offline
BEDROCK_MODEL_ID=
MODEL_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# Adapters
# "memory" and "deterministic" keep every local run free of paid calls.
# -----------------------------------------------------------------------------
POOL_REPOSITORY=memory
DYNAMODB_TABLE=pool-state
ROUTING_PROVIDER=deterministic
MAX_ROUTE_MATRIX_CELLS=100

# -----------------------------------------------------------------------------
# Payments (AGENTS.md §4, brief §12 and §54)
#
# "simulated" is a deterministic in-process provider: no network, no cost, no real
# money, and it can be made to decline a card on purpose so the recovery branch is
# testable.
#
# "stripe" is TEST MODE ONLY. The application refuses to construct the Stripe provider
# with anything that is not an `sk_test_` key — there is no flag that relaxes this, so a
# misconfigured environment fails loudly instead of charging a real card.
#
# Put real values in `.env` (never committed) or in the deployed function's
# configuration. Never in a CDK stack: that ends up in the synthesized template.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=simulated
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Purchase execution (brief §63)
# Only the clearly-labelled simulated executor exists in this build. It contacts no
# supplier, moves no money, and flags every record it writes as synthetic.
# -----------------------------------------------------------------------------
PURCHASE_EXECUTOR=simulated

# -----------------------------------------------------------------------------
# COST SAFETY — agent loop bounds (AGENTS.md §3.1)
# These are hard limits, not hints. A run that hits one must terminate loudly as a
# recorded loop fault. Tune deliberately; do not raise one to make a failing run pass.
# -----------------------------------------------------------------------------
MAX_AGENT_ITERATIONS=8
MAX_TOOL_RETRIES=3
MAX_TOOL_CALLS_PER_RUN=25
MAX_DUPLICATE_TOOL_CALLS=2
WORKFLOW_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# COST SAFETY — background execution kill switch (AGENTS.md §3.2)
# Scheduled and recurring work is DISABLED by default. Enable only while actively
# testing it, and disable again when finished. A forgotten schedule spends credits
# while nobody is at the keyboard.
# -----------------------------------------------------------------------------
SCHEDULES_ENABLED=false
