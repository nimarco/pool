%% Pool — implemented architecture.
%% Everything on this diagram exists in the repository. Nothing aspirational appears
%% here; future work is listed in ARCHITECTURE.md and PILOT_READINESS.md instead.
%% Render: npx -y @mermaid-js/mermaid-cli -i docs/architecture.mmd -o docs/architecture.svg
flowchart TB
    classDef people fill:#f8ece3,stroke:#e5c4a9,color:#1c1a17
    classDef edge fill:#e8eef5,stroke:#b6c8dd,color:#1c1a17
    classDef agent fill:#e6efe7,stroke:#b9d2be,color:#1c1a17
    classDef pure fill:#ffffff,stroke:#cfc7ba,color:#1c1a17
    classDef ext fill:#f2efe9,stroke:#cfc7ba,color:#5d5850
    classDef off fill:#f2efe9,stroke:#cfc7ba,color:#8b857b,stroke-dasharray: 4 3

    subgraph HUMANS[" "]
        direction LR
        BUYER["Buyer<br/><i>declares recurring needs</i>"]:::people
        HOST["Host / runner<br/><i>paid fulfilment</i>"]:::people
        OP["Operator<br/><i>offers, issues, overrides</i>"]:::people
    end

    WEB["React app<br/>buyer · host · operator · judge"]:::edge
    CDN["S3 + CloudFront"]:::ext
    API["FastAPI<br/>uvicorn local · Lambda + API Gateway cloud"]:::edge

    subgraph SVC["services/ — orchestration"]
        direction LR
        COORD["coordination<br/>discover · form · price · lock"]:::agent
        HOSTS["hosting<br/>recruit · rank · offer"]:::agent
        PAY["payments<br/>authorise · capture · webhooks"]:::agent
        FULF["fulfillment<br/>purchase · pickup · issues"]:::agent
        COMMS["communication<br/>updates · exceptions"]:::agent
    end

    subgraph AGENT["agent/ — Strands"]
        direction LR
        LOOP["PoolCoordinator<br/>one bounded run"]:::agent
        TOOLS["12 typed tools"]:::agent
        BOUNDS["BoundedRun hooks<br/>iterations · calls · duplicates · clock"]:::agent
        PLAN["Offline planner<br/><i>local only, zero tokens</i>"]:::off
    end

    subgraph DOMAIN["domain/ — pure, no I/O"]
        direction LR
        ECON["economics<br/>landed price · host reward · case fitting"]:::pure
        VIA["viability<br/>four-party gate"]:::pure
        POL["policy<br/>Smart Join"]:::pure
        MATCH["matching · timing · substitution"]:::pure
        STATE["state machine · money · pickup"]:::pure
    end

    subgraph ADAPT["adapters/"]
        direction LR
        REPO["repository"]:::pure
        ROUTE["routing"]:::pure
        PAYP["payment provider"]:::pure
        PURCH["purchase executor"]:::pure
        SRC["sourcing"]:::pure
        VER["verification"]:::pure
    end

    BEDROCK["Amazon Bedrock<br/><i>model inference</i>"]:::ext
    AGENTCORE["Bedrock AgentCore Runtime<br/><i>agentcore_app.py</i>"]:::ext
    DDB[("DynamoDB<br/>single table · on-demand · TTL")]:::ext
    LOC["Amazon Location<br/>geo-routes"]:::ext
    EB["EventBridge<br/><i>created DISABLED</i>"]:::off
    CW["CloudWatch<br/>run records · 14-day retention"]:::ext
    STRIPE["Stripe<br/><b>TEST mode only</b>"]:::ext
    SIMBUY["Simulated purchase<br/><i>no supplier contacted</i>"]:::off

    BUYER --> WEB
    HOST --> WEB
    OP --> WEB
    CDN --> WEB
    WEB --> API
    API --> SVC
    API --> LOOP

    LOOP --> BOUNDS
    LOOP --> TOOLS
    LOOP -.->|"MODEL_PROVIDER=offline"| PLAN
    LOOP -->|"MODEL_PROVIDER=bedrock"| BEDROCK
    AGENTCORE --> LOOP
    EB -.->|"manual trigger by default"| API

    TOOLS --> SVC
    SVC --> DOMAIN
    SVC --> ADAPT

    REPO --> DDB
    ROUTE --> LOC
    PAYP --> STRIPE
    PURCH --> SIMBUY
    LOOP --> CW

    COORD -.- ECON
    COORD -.- VIA
    COORD -.- POL
    HOSTS -.- ECON
    PAY -.- STATE
    FULF -.- STATE
