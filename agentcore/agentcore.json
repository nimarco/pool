{
  "name": "Pool",
  "version": 1,
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "Pool",
    "Project": "Pool",
    "Hackathon": "AgentsForHumans",
    "Environment": "dev"
  },
  "runtimes": [
    {
      "name": "PoolCoordinator",
      "description": "Pool autonomous collective-purchasing coordinator (Strands + Bedrock)",
      "build": "CodeZip",
      "entrypoint": "agentcore_app.py",
      "codeLocation": "services/agent/",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "instrumentation": {
        "enableOtel": true
      },
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 60,
        "maxLifetime": 300
      },
      "additionalPolicies": ["iam/agentcore-dynamodb.json"],
      "envVars": [
        { "name": "MODEL_PROVIDER", "value": "bedrock" },
        { "name": "BEDROCK_MODEL_ID", "value": "us.amazon.nova-lite-v1:0" },
        { "name": "MODEL_MAX_TOKENS", "value": "2048" },
        { "name": "POOL_REPOSITORY", "value": "dynamodb" },
        { "name": "DYNAMODB_TABLE", "value": "pool-demo-state" },
        { "name": "DYNAMODB_CONSISTENT_READS", "value": "true" },
        { "name": "ROUTING_PROVIDER", "value": "deterministic" },
        { "name": "PAYMENT_PROVIDER", "value": "simulated" },
        { "name": "PURCHASE_EXECUTOR", "value": "simulated" },
        { "name": "SCHEDULES_ENABLED", "value": "false" },
        { "name": "MAX_AGENT_ITERATIONS", "value": "8" },
        { "name": "MAX_TOOL_CALLS_PER_RUN", "value": "25" },
        { "name": "MAX_DUPLICATE_TOOL_CALLS", "value": "2" },
        { "name": "WORKFLOW_TIMEOUT_SECONDS", "value": "45" },
        { "name": "MAX_ROUTE_MATRIX_CELLS", "value": "100" },
        { "name": "LOG_LEVEL", "value": "INFO" }
      ]
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": []
}
